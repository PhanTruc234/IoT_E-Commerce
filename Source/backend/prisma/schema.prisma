generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ProductType {
  SIMPLE
  VARIABLE
  COMBO
}

enum SpecDataType {
  TEXT
  NUMBER
  BOOLEAN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

enum SerialStatus {
  IN_STOCK
  ACTIVATED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserEventType {
  VIEW_PRODUCT
  SEARCH
  ADD_TO_CART
  VIEW_CATEGORY
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING_EMAIL
  MARKETING_SMS
}

enum TicketType {
  GENERAL
  ORDER
  RETURN
  WARRANTY
  COMPLAINT
  PAYMENT
  SHIPPING
  PRIVACY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReviewModerationReason {
  SPAM
  OFFENSIVE
  IRRELEVANT
  FAKE
  PERSONAL_INFO
  OTHER
}

enum CouponType {
  PRODUCT_DISCOUNT
  FREE_SHIPPING
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionScope {
  ALL
  CATEGORY
  PRODUCT
}

enum NotificationType {
  SYSTEM
  PROMOTION
  COUPON
  ORDER
}

enum NotificationAudience {
  ALL
  USER
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String?
  fullName          String
  phone             String?
  address           String?
  avatarUrl         String?
  googleId          String?            @unique
  role              Role               @default(CUSTOMER)
  isActive          Boolean            @default(true)
  isEmailVerified   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  cart              Cart?
  orders            Order[]
  serials           Serial[]
  serialsOwned      Serial[]           @relation("SerialOwner")
  questions         Question[]
  reviews           Review[]
  userConsents      UserConsent[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  wishlists         Wishlist[]
  userCoupons       UserCoupon[]
  notifications     Notification[]
  notificationReads NotificationRead[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(uuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?
  icon        String?
  level       Int      @default(1)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent              Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[]          @relation("CategoryTree")
  products            Product[]
  promotionCategories PromotionCategory[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

model Product {
  id            String        @id @default(uuid())
  categoryId    String
  brandId       String?
  sku           String        @unique
  name          String
  slug          String        @unique
  description   String?
  price         Int
  salePrice     Int?
  stockQuantity Int           @default(0)
  status        ProductStatus @default(ACTIVE)
  type          ProductType   @default(SIMPLE)
  viewCount     Int           @default(0)
  soldCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images            ProductImage[]
  specifications    ProductSpecification[]
  attributes        ProductAttribute[]
  variants          ProductVariant[]
  comboItems        ComboItem[]            @relation("ComboParent")
  usedInCombos      ComboItem[]            @relation("ComboComponent")
  cartItems         CartItem[]
  orderItems        OrderItem[]
  serials           Serial[]
  questions         Question[]
  reviews           Review[]
  wishlists         Wishlist[]
  promotionProducts PromotionProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  imageUrl  String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Specification {
  id        String       @id @default(uuid())
  name      String       @unique
  unit      String?
  dataType  SpecDataType @default(TEXT)
  createdAt DateTime     @default(now())

  productValues ProductSpecification[]

  @@map("specifications")
}

model ProductSpecification {
  id              String @id @default(uuid())
  productId       String
  specificationId String
  value           String

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  specification Specification @relation(fields: [specificationId], references: [id], onDelete: Restrict)

  @@unique([productId, specificationId])
  @@index([productId])
  @@map("product_specifications")
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String
  name      String
  isVariant Boolean @default(false)
  sortOrder Int     @default(0)

  product Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductAttributeOption[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_attributes")
}

model ProductAttributeOption {
  id          String @id @default(uuid())
  attributeId String
  value       String
  sortOrder   Int    @default(0)

  attribute    ProductAttribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantLinks ProductVariantOption[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("product_attribute_options")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  sku           String   @unique
  price         Int
  salePrice     Int?
  stockQuantity Int      @default(0)
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ProductVariantOption[]
  comboUses  ComboItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  serials    Serial[]

  @@index([productId])
  @@map("product_variants")
}

model ProductVariantOption {
  id        String @id @default(uuid())
  variantId String
  optionId  String

  variant ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option  ProductAttributeOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([variantId, optionId])
  @@index([variantId])
  @@map("product_variant_options")
}

model ComboItem {
  id        String  @id @default(uuid())
  comboId   String
  productId String
  variantId String?
  quantity  Int     @default(1)

  combo     Product         @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  component Product         @relation("ComboComponent", fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([comboId, productId])
  @@index([comboId])
  @@map("combo_items")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                 String        @id @default(uuid())
  code               String        @unique
  userId             String
  recipientName      String
  phone              String
  address            String
  province           String?
  note               String?
  discountAmount     Int           @default(0)
  shippingDiscount   Int           @default(0)
  productCouponCode  String?
  shippingCouponCode String?
  subtotal           Int
  shippingFee        Int           @default(0)
  total              Int
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(UNPAID)
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  serials              Serial[]
  orderStatusHistories OrderStatusHistory[]
  supportTickets       SupportTicket[]
  reviews              Review[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  name         String
  variantLabel String?
  image        String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Serial {
  id             String       @id @default(uuid())
  code           String       @unique
  productId      String
  variantId      String?
  status         SerialStatus @default(IN_STOCK)
  warrantyMonths Int          @default(12)
  ownerUserId    String?
  orderId        String?
  activatedAt    DateTime?
  warrantyEndAt  DateTime?
  ownerName      String?
  ownerPhone     String?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner   User?           @relation("SerialOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [userId], references: [id])
  userId  String?
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("serials")
}

model Question {
  id         String    @id @default(uuid())
  productId  String
  userId     String
  content    String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("questions")
}

model Review {
  id               String                  @id @default(uuid())
  productId        String
  userId           String
  orderId          String?
  rating           Int
  comment          String?
  status           ReviewStatus            @default(PENDING)
  verifiedPurchase Boolean                 @default(false)
  moderationReason ReviewModerationReason?
  approvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

model UserEvent {
  id         String        @id @default(uuid())
  type       UserEventType
  userId     String?
  productId  String?
  categoryId String?
  keyword    String?
  createdAt  DateTime      @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("user_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  role       String?
  action     String
  entity     String?
  entityId   String?
  method     String
  path       String
  summary    String?
  statusCode Int
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([role, createdAt])
  @@map("audit_logs")
}

model UserConsent {
  id        String      @id @default(uuid())
  userId    String
  type      ConsentType
  version   String
  granted   Boolean     @default(true)
  grantedAt DateTime?
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_consents")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model SupportTicket {
  id        String       @id @default(uuid())
  code      String       @unique
  userId    String
  orderId   String?
  type      TicketType   @default(GENERAL)
  status    TicketStatus @default(OPEN)
  subject   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(uuid())
  ticketId    String
  senderId    String?
  isStaff     Boolean  @default(false)
  body        String
  attachments String[] @default([])
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("support_messages")
}

model ShippingZone {
  id        String   @id @default(uuid())
  name      String
  fee       Int
  provinces String[] @default([])
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipping_zones")
}

model ShippingSetting {
  id           String   @id @default(uuid())
  freeShipFrom Int      @default(500000)
  updatedAt    DateTime @updatedAt

  @@map("shipping_settings")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  description  String?
  type         CouponType   @default(PRODUCT_DISCOUNT)
  discountType DiscountType @default(PERCENT)
  value        Int          @default(0)
  maxDiscount  Int?
  minOrder     Int          @default(0)
  usageLimit   Int?
  usedCount    Int          @default(0)
  perUserLimit Int          @default(1)
  startAt      DateTime?
  endAt        DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userCoupons UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id       String    @id @default(uuid())
  userId   String
  couponId String
  savedAt  DateTime  @default(now())
  usedAt   DateTime?
  orderId  String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@index([userId])
  @@map("user_coupons")
}

model Promotion {
  id           String         @id @default(uuid())
  name         String
  description  String?
  bannerImage  String?
  linkUrl      String?
  discountType DiscountType   @default(PERCENT)
  value        Int            @default(0)
  maxDiscount  Int?
  scope        PromotionScope @default(ALL)
  priority     Int            @default(0)
  startAt      DateTime?
  endAt        DateTime?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  products   PromotionProduct[]
  categories PromotionCategory[]

  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model PromotionCategory {
  promotionId String
  categoryId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@map("promotion_categories")
}

model Notification {
  id        String               @id @default(uuid())
  title     String
  body      String
  type      NotificationType     @default(SYSTEM)
  audience  NotificationAudience @default(ALL)
  userId    String?
  linkUrl   String?
  createdAt DateTime             @default(now())

  user  User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads NotificationRead[]

  @@index([audience, createdAt])
  @@index([userId])
  @@map("notifications")
}

model NotificationRead {
  id             String   @id @default(uuid())
  userId         String
  notificationId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("notification_reads")
}
