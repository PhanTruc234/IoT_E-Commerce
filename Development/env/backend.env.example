NODE_ENV=production
PORT=3001


DATABASE_URL=


JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.iotech.fun


CORS_ORIGINS=https://iotech.fun,https://www.iotech.fun
FRONTEND_URL=https://iotech.fun


# Nginx đứng trước backend: tin 1 lớp proxy, lấy IP thật từ X-Forwarded-For.
# Không qua Cloudflare thì PHẢI để trống CLIENT_IP_HEADER (nếu để cf-connecting-ip, ai cũng giả được IP).
TRUST_PROXY=1
CLIENT_IP_HEADER=
SWAGGER_ENABLED=false


GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=


VNP_TMNCODE=ma_tmncode_cua_ban
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://api.iotech.fun/api/payments/vnpay/return


R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=
R2_BUCKET=iotech
R2_PUBLIC_URL=https://xxxx.r2.dev


# GHN — sandbox: dev-online-gateway; chạy thật: https://online-gateway.ghn.vn/shiip/public-api
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
# Chuỗi ngẫu nhiên, khai trùng với header X-Webhook-Secret trên portal GHN
GHN_WEBHOOK_SECRET=